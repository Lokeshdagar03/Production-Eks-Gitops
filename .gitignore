# Terraform
**/.terraform/*
*.tfstate
*.tfstate.*
.terraform.lock.hcl
*.tfvars
*.tfplan

# Ignore provider locks inside modules
terraform/modules/**/.terraform.lock.hcl

# Keep only the environment lock file
!terraform/environments/dev/.terraform.lock.hcl

# Variables
*.tfvars
!terraform/environments/dev/terraform.tfvars.example

# Logs
crash.log
crash.*.log

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db
